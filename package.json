{
  "name": "@ifaka/native-ui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A lightweight, accessible CSS UI system for semantic HTML, responsive layouts, and framework-free web interfaces.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFAKA/native-ui.git"
  },
  "homepage": "https://ifaka.github.io/native-ui/",
  "bugs": {
    "url": "https://github.com/IFAKA/native-ui/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "recipes",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "native-ui": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/native-ui.css",
    "./behavior.js": "./dist/behavior.js",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:package": "node scripts/build.mjs --package-only",
    "build:site": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test && npm run build && npm run check",
    "test:browser-contract": "node --test tests/browser/**/*.spec.mjs",
    "test:browser": "playwright test tests/browser/real-browser.spec.mjs tests/browser/site.spec.mjs",
    "measure": "node scripts/measure.mjs",
    "pack:check": "npm pack --dry-run",
    "pack:consumer": "node scripts/pack-consumer.mjs"
  },
  "keywords": [
    "html",
    "css",
    "semantic-html",
    "native-web",
    "design-system",
    "accessibility",
    "progressive-enhancement",
    "framework-agnostic"
  ],
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "axe-core": "4.11.0"
  }
}
