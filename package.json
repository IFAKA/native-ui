{
  "name": "@ifaka/native-ui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "An attractive, adaptive, HTML-first UI system with minimal CSS and optional progressive behavior.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFAKA/native-ui.git"
  },
  "homepage": "https://ifaka.github.io/native-ui/",
  "bugs": {
    "url": "https://github.com/IFAKA/native-ui/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "recipes",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/native-ui.css",
    "./behavior.js": "./dist/behavior.js",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test && npm run build && npm run check",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "html",
    "css",
    "semantic-html",
    "native-web",
    "design-system",
    "accessibility",
    "progressive-enhancement",
    "framework-agnostic"
  ]
}
